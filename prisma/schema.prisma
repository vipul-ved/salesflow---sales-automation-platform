// Prisma Schema for SalesFlow AI - Multi-Tenant CRM & Sales Automation SaaS
// Supports PostgreSQL (Supabase) as primary production database & SQLite fallback for instant local dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  industry    String?
  website     String?
  address     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  plan        String   @default("PRO") // FREE, PRO, BUSINESS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  teams             Team[]
  leads             Lead[]
  contacts          Contact[]
  companies         Company[]
  deals             Deal[]
  pipelines         Pipeline[]
  products          Product[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
  activities        Activity[]
  notes             Note[]
  files             File[]
  emails            Email[]
  emailTemplates    EmailTemplate[]
  workflows         Workflow[]
  aiInteractions    AIInteraction[]
  goals             Goal[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  customFields      CustomField[]
  auditLogs         AuditLog[]
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  avatar         String?
  role           String   @default("SALES_AGENT") // OWNER, ADMIN, MANAGER, SALES_AGENT, VIEWER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedLeads     Lead[]           @relation("LeadOwner")
  assignedContacts  Contact[]        @relation("ContactOwner")
  assignedCompanies Company[]        @relation("CompanyOwner")
  assignedDeals     Deal[]           @relation("DealOwner")
  assignedTasks     Task[]           @relation("TaskAssignee")
  organizedEvents   CalendarEvent[]  @relation("EventOrganizer")
  activities        Activity[]
  notes             Note[]
  aiInteractions    AIInteraction[]
  goals             Goal[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
}

model Team {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  company         String?
  jobTitle        String?
  website         String?
  industry        String?
  location        String?
  source          String   @default("Website") // Website, Referral, LinkedIn, Organic, Ads
  status          String   @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, NURTURING, CONVERTED, LOST
  score           Int      @default(50)
  expectedValue   Float    @default(0)
  currency        String   @default("USD")
  tags            String   @default("[]") // JSON string array
  notes           String?
  
  ownerId         String?
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           Task[]
  calendarEvents  CalendarEvent[]
  activities      Activity[]
  notesList       Note[]
  emails          Email[]
}

model Contact {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  jobTitle       String?
  website        String?
  linkedIn       String?
  location       String?
  birthday       String?
  tags           String   @default("[]")
  notes          String?
  
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deals          Deal[]
  tasks          Task[]
  activities     Activity[]
  notesList      Note[]
  emails         Email[]
}

model Company {
  id             String   @id @default(uuid())
  name           String
  website        String?
  industry       String?
  employees      String?
  revenue        String?
  phone          String?
  email          String?
  address        String?
  country        String?
  state          String?
  city           String?
  tags           String   @default("[]")
  notes          String?
  
  ownerId        String?
  owner          User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts       Contact[]
  deals          Deal[]
  tasks          Task[]
  activities     Activity[]
  notesList      Note[]
}

model Pipeline {
  id             String   @id @default(uuid())
  name           String
  isDefault      Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  stages         PipelineStage[]
  deals          Deal[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PipelineStage {
  id          String   @id @default(uuid())
  name        String
  order       Int
  probability Int      @default(50)
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id                String   @id @default(uuid())
  name              String
  amount            Float
  currency          String   @default("USD")
  probability       Int      @default(50)
  expectedCloseDate DateTime?
  source            String?
  notes             String?
  tags              String   @default("[]")
  status            String   @default("ACTIVE") // ACTIVE, WON, LOST
  lostReason        String?

  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipelineId        String
  pipeline          Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products          DealProduct[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
  activities        Activity[]
  notesList         Note[]
  emails            Email[]
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String?
  sku            String
  price          Float
  currency       String   @default("USD")
  category       String?
  taxRate        Float    @default(0)
  active         Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealProducts   DealProduct[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DealProduct {
  id        String  @id @default(uuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  unitPrice Float
  discount  Float   @default(0)
  total     Float
}

model Task {
  id             String   @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime?
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CalendarEvent {
  id             String   @id @default(uuid())
  title          String
  description    String?
  eventType      String   @default("MEETING") // MEETING, CALL, DEMO, FOLLOW_UP, TASK, OTHER
  startTime      DateTime
  endTime        DateTime
  location       String?
  meetLink       String?
  
  organizerId    String?
  organizer      User?        @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Activity {
  id             String   @id @default(uuid())
  type           String   // LEAD_CREATED, STATUS_CHANGED, EMAIL_SENT, CALL_LOGGED, NOTE_ADDED, TASK_COMPLETED, DEAL_WON, DEAL_LOST, STAGE_CHANGED
  description    String
  metadata       String?  // JSON string
  
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}

model Note {
  id             String   @id @default(uuid())
  content        String
  
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model File {
  id             String   @id @default(uuid())
  fileName       String
  fileUrl        String
  fileSize       Int
  fileType       String
  entityType     String?  // LEAD, CONTACT, COMPANY, DEAL
  entityId       String?
  uploadedById   String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Email {
  id             String   @id @default(uuid())
  subject        String
  body           String
  fromEmail      String
  toEmail        String
  status         String   @default("SENT") // SENT, RECEIVED, DRAFT
  
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  threadId       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}

model EmailTemplate {
  id             String   @id @default(uuid())
  name           String
  subject        String
  body           String
  variables      String   @default("[]") // JSON string array
  category       String   @default("Outreach")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Workflow {
  id             String   @id @default(uuid())
  name           String
  description    String?
  triggerEvent   String   // LEAD_CREATED, DEAL_STAGE_CHANGED, DEAL_WON, TASK_COMPLETED
  active         Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  triggers       WorkflowTrigger[]
  conditions     WorkflowCondition[]
  actions        WorkflowAction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WorkflowTrigger {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggerType String
  config      String   @default("{}")
}

model WorkflowCondition {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  field       String
  operator    String   // EQUALS, GREATER_THAN, LESS_THAN, CONTAINS
  value       String
}

model WorkflowAction {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actionType  String   // ASSIGN_LEAD, CREATE_TASK, SEND_EMAIL, NOTIFY_USER, TRIGGER_WEBHOOK
  config      String   @default("{}")
}

model AIInteraction {
  id             String   @id @default(uuid())
  prompt         String
  response       String
  model          String   @default("gpt-4o")
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Goal {
  id             String   @id @default(uuid())
  title          String
  targetAmount   Float
  currentAmount  Float    @default(0)
  period         String   @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL
  metric         String   @default("REVENUE") // REVENUE, DEALS_WON, LEADS_QUALIFIED
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ApiKey {
  id             String    @id @default(uuid())
  name           String
  keyHash        String    @unique
  keyPrefix      String
  scopes         String    @default("[\"read\", \"write\"]")
  lastUsedAt     DateTime?
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

model Webhook {
  id             String   @id @default(uuid())
  name           String
  url            String
  events         String   @default("[]") // JSON array of event names
  secret         String
  active         Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  deliveries     WebhookDelivery[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  statusCode Int
  payload    String
  response   String?
  createdAt  DateTime @default(now())
}

model CustomField {
  id             String   @id @default(uuid())
  entityType     String   // LEAD, CONTACT, COMPANY, DEAL
  fieldName      String
  fieldLabel     String
  fieldType      String   // TEXT, NUMBER, CURRENCY, DATE, BOOLEAN, DROPDOWN
  options        String   @default("[]")
  required       Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entityType     String
  entityId       String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  oldData        String?
  newData        String?
  ipAddress      String?
  userAgent      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}
